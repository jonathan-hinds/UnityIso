<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/Resources/UI/TacticsMainMenu.uss" />
    <ui:VisualElement name="main-menu-root" class="menu-root">
        <ui:VisualElement name="menu-backdrop" class="menu-backdrop">
            <ui:VisualElement name="background-shade" class="background-shade" />
            <ui:VisualElement name="ambient-glow-top" class="ambient-glow ambient-glow--top" />
            <ui:VisualElement name="ambient-glow-bottom" class="ambient-glow ambient-glow--bottom" />

            <ui:VisualElement name="main-page" class="menu-shell menu-shell--main">
                <ui:VisualElement name="crest-column" class="crest-column">
                    <ui:Label name="chapter-label" class="chapter-label" text="TACTICAL CHRONICLE" />
                    <ui:VisualElement name="crest-line" class="crest-line" />
                    <ui:Label name="title-label" class="title-label" text="ISOMETRIC RPG" />
                    <ui:Label name="subtitle-label" class="subtitle-label" text="A sleek war-room overture for duels, alliances, and the party you carry into battle." />
                </ui:VisualElement>

                <ui:VisualElement class="main-stage">
                    <ui:VisualElement name="landing-panel" class="command-panel flow-panel">
                        <ui:Label class="command-heading" text="Select Mode" />
                        <ui:Label class="command-copy" text="Choose a solo campaign route or step into online co-op. Each path keeps its own party flow and battle prep." />
                        <ui:Button name="single-player-mode-button" class="menu-button menu-button--primary" text="Single Player" />
                        <ui:Button name="online-coop-mode-button" class="menu-button menu-button--secondary" text="Online Co-op" />
                    </ui:VisualElement>

                    <ui:VisualElement name="single-player-panel" class="command-panel flow-panel" style="display: none;">
                        <ui:VisualElement class="panel-topbar">
                            <ui:Button name="single-player-back-button" class="menu-button menu-button--secondary menu-button--compact menu-button--chrome" text="Back" />
                            <ui:Label class="panel-kicker" text="Single Player" />
                        </ui:VisualElement>
                        <ui:Label class="command-heading" text="Solo Command" />
                        <ui:Label class="command-copy" text="Tune your formation, then move straight into a local match with the current procedural battlefield settings." />
                        <ui:Label name="team-summary-label" class="team-summary-label" text="Local Team:" />
                        <ui:Button name="edit-team-button" class="menu-button menu-button--secondary" text="Edit Team" />
                        <ui:Button name="play-button" class="menu-button menu-button--primary" text="Play Match" />
                    </ui:VisualElement>

                    <ui:VisualElement name="online-panel" class="command-panel flow-panel" style="display: none;">
                        <ui:VisualElement class="panel-topbar">
                            <ui:Button name="online-back-button" class="menu-button menu-button--secondary menu-button--compact menu-button--chrome" text="Back" />
                            <ui:Label class="panel-kicker" text="Online Co-op" />
                        </ui:VisualElement>
                        <ui:Label class="command-heading" text="Alliance Network" />
                        <ui:Label class="command-copy" text="Manage your cloud-backed party, host a relay match, or join an ally with their party code." />
                        <ui:Label name="online-team-summary-label" class="team-summary-label" text="Online Team:" />
                        <ui:Button name="edit-online-team-button" class="menu-button menu-button--secondary" text="Edit Team" />
                        <ui:TextField name="join-address-field" class="join-address-field join-address-field--stacked" label="Enter Party Code" value="" />
                        <ui:Button name="host-online-button" class="menu-button menu-button--primary" text="Host Match" />
                        <ui:Button name="join-online-button" class="menu-button menu-button--secondary" text="Join Match" />
                    </ui:VisualElement>

                    <ui:Label name="status-label" class="status-label status-label--main" text="" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="auth-dialog-overlay" class="auth-overlay" style="display: none;">
                <ui:VisualElement name="auth-dialog" class="auth-dialog">
                    <ui:Label class="auth-dialog-kicker" text="Online Co-op" />
                    <ui:Label class="auth-dialog-title" text="Sign In Or Register" />
                    <ui:Label class="auth-dialog-copy" text="Use your player account to sync your online party, host matches, and join an ally by party code." />
                    <ui:TextField name="account-username-field" class="join-address-field auth-field" label="Username" value="" />
                    <ui:TextField name="account-password-field" class="join-address-field auth-field" label="Password" value="" />
                    <ui:Label name="account-status-label" class="account-status-label" text="" />
                    <ui:VisualElement class="auth-button-row">
                        <ui:Button name="account-sign-in-button" class="menu-button menu-button--primary menu-button--compact auth-button" text="Sign In" />
                        <ui:Button name="account-register-button" class="menu-button menu-button--secondary menu-button--compact auth-button" text="Register" />
                    </ui:VisualElement>
                    <ui:Button name="auth-cancel-button" class="menu-button menu-button--secondary menu-button--compact auth-cancel-button" text="Cancel" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="host-setup-page" class="menu-shell host-setup-shell" style="display: none;">
                <ui:VisualElement class="host-setup-header">
                    <ui:VisualElement name="relay-code-container" class="relay-code-header" style="display: none;">
                        <ui:Label class="relay-code-header-caption" text="Relay Code" />
                        <ui:Label name="relay-code-label" class="relay-code-header-label" text="---- ----" />
                        <ui:Button name="copy-relay-code-button" class="menu-button menu-button--secondary menu-button--compact relay-copy-button" text="Copy" />
                    </ui:VisualElement>
                    <ui:VisualElement class="editor-button-row">
                        <ui:Button name="host-setup-back-button" class="menu-button menu-button--secondary menu-button--compact editor-button" text="Back" />
                        <ui:Button name="host-setup-confirm-button" class="menu-button menu-button--primary menu-button--compact editor-button editor-button-save" text="Host Match" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="host-setup-content">
                    <ui:VisualElement class="host-intro-panel">
                        <ui:Label class="section-label" text="Co-op Match Configuration" />
                        <ui:Label class="section-copy" text="Shape the battlefield before the relay opens. The host publishes one authoritative battle setup so both allied parties enter the same encounter." />
                    </ui:VisualElement>

                    <ui:VisualElement class="host-grid">
                        <ui:VisualElement class="editor-section host-section host-section--half host-section--left">
                            <ui:Label class="section-label" text="General" />
                            <ui:VisualElement class="host-field-row">
                                <ui:IntegerField name="host-seed-field" class="host-number-field" label="Seed" value="1222" />
                                <ui:IntegerField name="host-width-field" class="host-number-field" label="Width" value="15" />
                                <ui:IntegerField name="host-length-field" class="host-number-field" label="Length" value="10" />
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="editor-section host-section host-section--half">
                            <ui:Label class="section-label" text="Elevation" />
                            <ui:VisualElement class="host-field-stack">
                                <ui:FloatField name="host-noise-scale-field" class="host-number-field host-number-field--wide" label="Noise Scale" value="5" />
                                <ui:VisualElement class="host-slider-row">
                                    <ui:Label class="host-slider-label" text="Noise Octaves" />
                                    <ui:SliderInt name="host-noise-octaves-slider" class="host-slider" low-value="1" high-value="6" value="3" />
                                    <ui:Label name="host-noise-octaves-value-label" class="host-slider-value" text="3" />
                                </ui:VisualElement>
                                <ui:VisualElement class="host-field-row">
                                    <ui:IntegerField name="host-min-elevation-field" class="host-number-field" label="Min Elevation" value="1" />
                                    <ui:IntegerField name="host-max-elevation-field" class="host-number-field" label="Max Elevation" value="8" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>

                        <ui:VisualElement class="editor-section host-section host-section--enemies">
                            <ui:VisualElement class="host-section-header">
                                <ui:Label class="section-label" text="Enemies" />
                                <ui:Button name="host-add-enemy-button" class="menu-button menu-button--secondary menu-button--compact host-add-enemy-button" text="Add Enemy" />
                            </ui:VisualElement>
                            <ui:Label class="section-copy" text="Add up to ten unique enemy types. Each row lets the host pick a unit from the enemy table and set how many spawn into the match." />
                            <ui:ScrollView class="host-enemy-scroll-view" mode="Vertical">
                                <ui:VisualElement name="host-enemy-entry-container" class="host-enemy-entry-container" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="host-setup-status-label" class="editor-status-label host-setup-status-label" text="" />
            </ui:VisualElement>

            <ui:VisualElement name="edit-team-page" class="menu-shell editor-shell" style="display: none;">
                <ui:VisualElement name="editor-header" class="editor-header">
                    <ui:VisualElement class="editor-button-row">
                        <ui:Button name="editor-back-button" class="menu-button menu-button--secondary menu-button--compact editor-button" text="Back" />
                        <ui:Button name="editor-save-button" class="menu-button menu-button--primary menu-button--compact editor-button editor-button-save" text="Save Team" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement name="editor-content" class="editor-content">
                    <ui:VisualElement class="editor-section editor-section--slots">
                        <ui:Label class="section-label" text="Deployment Slots" />
                        <ui:Label class="section-copy" text="Drag a playable character into one of three active squad positions. Dropping an assigned unit back into the roster clears that slot." />
                        <ui:VisualElement name="team-slot-container" class="team-slot-container" />
                    </ui:VisualElement>

                    <ui:VisualElement class="editor-section editor-section--roster">
                        <ui:Label class="section-label" text="Available Operatives" />
                        <ui:Label class="section-copy" text="Hover any operative to preview a southwest run cycle on the same isometric tile language used by the battlefield." />
                        <ui:ScrollView name="roster-scroll-view" class="roster-scroll-view" mode="Vertical">
                            <ui:VisualElement name="character-grid-container" class="character-grid-container" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="editor-status-label" class="editor-status-label" text="" />
            </ui:VisualElement>

            <ui:Label name="drag-ghost" class="drag-ghost" text="" style="display: none;" />
            <ui:VisualElement name="frame-top" class="frame-line frame-line--top" />
            <ui:VisualElement name="frame-bottom" class="frame-line frame-line--bottom" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
