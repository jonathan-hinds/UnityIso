:root {
    --menu-ink: rgba(255, 244, 224, 1);
    --menu-soft-ink: rgba(243, 205, 176, 0.88);
    --menu-gold: rgba(255, 189, 122, 1);
    --menu-gold-soft: rgba(255, 162, 104, 0.26);
    --menu-panel: rgba(49, 23, 24, 0.80);
    --menu-panel-strong: rgba(35, 16, 17, 0.92);
    --menu-panel-soft: rgba(255, 241, 218, 0.07);
    --menu-border: rgba(255, 216, 183, 0.18);
    --menu-border-strong: rgba(255, 182, 109, 0.72);
    --menu-accent: rgba(130, 57, 41, 0.98);
    --menu-accent-soft: rgba(255, 138, 86, 0.18);
    --menu-shadow: rgba(22, 8, 10, 0.68);
}

.menu-root {
    flex-grow: 1;
}

.menu-backdrop {
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
    padding-left: 72px;
    padding-right: 72px;
    padding-top: 56px;
    padding-bottom: 56px;
    background-color: rgba(26, 10, 12, 0.98);
    background-image: resource("UI/Background");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
}

.background-shade {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(50, 14, 18, 0.46);
}

.ambient-glow {
    position: absolute;
    border-radius: 999px;
    opacity: 0.72;
}

.ambient-glow--top {
    left: -120px;
    top: -110px;
    width: 560px;
    height: 560px;
    background-color: rgba(255, 236, 170, 0.26);
}

.ambient-glow--bottom {
    right: -150px;
    bottom: -140px;
    width: 640px;
    height: 640px;
    background-color: rgba(255, 116, 70, 0.18);
}

.menu-shell {
    flex-grow: 1;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 226, 195, 0.18);
    border-bottom-color: rgba(255, 226, 195, 0.18);
    border-left-color: rgba(255, 226, 195, 0.08);
    border-right-color: rgba(255, 226, 195, 0.08);
    background-color: rgba(28, 10, 13, 0.38);
}

.menu-shell--main {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
}

.crest-column {
    width: 58%;
    justify-content: center;
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 60px;
    padding-bottom: 60px;
}

.chapter-label {
    color: var(--menu-soft-ink);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-bottom: 20px;
}

.crest-line {
    width: 420px;
    height: 1px;
    background-color: rgba(255, 189, 122, 0.92);
    margin-bottom: 26px;
}

.title-label {
    color: var(--menu-ink);
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 14px;
    margin-bottom: 12px;
}

.subtitle-label {
    color: var(--menu-soft-ink);
    font-size: 18px;
    letter-spacing: 3px;
    width: 560px;
    white-space: normal;
}

.main-stage {
    width: 470px;
    align-self: center;
    margin-right: 36px;
    justify-content: center;
}

.flow-panel {
    align-self: stretch;
}

.command-panel {
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 32px;
    padding-bottom: 28px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 222, 192, 0.22);
    border-bottom-color: rgba(255, 222, 192, 0.22);
    border-left-color: rgba(255, 222, 192, 0.12);
    border-right-color: rgba(255, 222, 192, 0.12);
    background-color: var(--menu-panel);
}

.panel-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.panel-kicker {
    color: rgba(255, 198, 132, 0.96);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.command-heading {
    color: var(--menu-ink);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 18px;
}

.command-copy,
.editor-copy,
.section-copy,
.auth-dialog-copy {
    color: var(--menu-soft-ink);
    font-size: 14px;
    white-space: normal;
}

.command-copy,
.auth-dialog-copy {
    margin-bottom: 24px;
}

.team-summary-label {
    color: rgba(255, 198, 132, 0.96);
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 18px;
    white-space: normal;
}

.join-address-field {
    margin-bottom: 14px;
    color: var(--menu-ink);
}

.join-address-field--stacked {
    margin-top: 4px;
}

.join-address-field .unity-base-field__label,
.host-number-field .unity-base-field__label,
.host-enemy-count-field .unity-base-field__label,
.host-enemy-dropdown .unity-base-field__label {
    min-width: 118px;
    color: var(--menu-soft-ink);
    letter-spacing: 1px;
}

.join-address-field .unity-base-text-field__input,
.host-number-field .unity-base-text-field__input,
.host-enemy-count-field .unity-base-text-field__input,
.host-enemy-dropdown .unity-base-popup-field__input {
    height: 40px;
    color: var(--menu-ink);
    background-color: rgba(63, 25, 24, 0.94);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 215, 181, 0.22);
    border-bottom-color: rgba(255, 215, 181, 0.22);
    border-left-color: rgba(255, 215, 181, 0.22);
    border-right-color: rgba(255, 215, 181, 0.22);
}

.menu-button {
    height: 56px;
    margin-bottom: 14px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    color: rgb(255, 244, 224);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 6px;
}

.menu-button--primary {
    border-top-color: var(--menu-border-strong);
    border-bottom-color: var(--menu-border-strong);
    border-left-color: var(--menu-border-strong);
    border-right-color: var(--menu-border-strong);
    background-color: rgba(122, 45, 31, 0.96);
}

.menu-button--secondary {
    border-top-color: rgba(255, 221, 193, 0.24);
    border-bottom-color: rgba(255, 221, 193, 0.24);
    border-left-color: rgba(255, 221, 193, 0.24);
    border-right-color: rgba(255, 221, 193, 0.24);
    background-color: rgba(61, 23, 23, 0.94);
}

.menu-button:hover {
    background-color: var(--menu-accent);
    border-top-color: rgba(255, 224, 171, 0.92);
    border-bottom-color: rgba(255, 224, 171, 0.92);
    border-left-color: rgba(255, 224, 171, 0.92);
    border-right-color: rgba(255, 224, 171, 0.92);
}

.menu-button:disabled {
    opacity: 0.45;
}

.menu-button--compact {
    height: 48px;
    min-width: 168px;
    margin-bottom: 0;
}

.menu-button--chrome {
    min-width: 108px;
}

.status-label,
.editor-status-label,
.account-status-label {
    color: rgba(255, 198, 132, 0.96);
    font-size: 13px;
    letter-spacing: 2px;
}

.status-label {
    margin-top: 14px;
    display: none;
}

.status-label--main {
    min-height: 20px;
}

.auth-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(18, 6, 9, 0.62);
}

.auth-dialog {
    width: 480px;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 30px;
    padding-bottom: 28px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 186, 118, 0.54);
    border-bottom-color: rgba(255, 186, 118, 0.54);
    border-left-color: rgba(255, 225, 197, 0.14);
    border-right-color: rgba(255, 225, 197, 0.14);
    background-color: var(--menu-panel-strong);
}

.auth-dialog-kicker {
    color: rgba(255, 198, 132, 0.96);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.auth-dialog-title {
    color: var(--menu-ink);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.auth-field {
    margin-bottom: 12px;
}

.auth-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 12px;
}

.auth-button {
    min-width: 0;
    flex-grow: 1;
    margin-right: 10px;
}

.auth-cancel-button {
    align-self: stretch;
}

.editor-shell {
    flex-direction: column;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 16px;
    padding-bottom: 16px;
}

.editor-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 8px;
}

.editor-button-row {
    flex-direction: row;
}

.editor-button {
    margin-right: 10px;
}

.editor-button-save {
    margin-right: 0;
}

.editor-content {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.editor-content--columns {
    flex-direction: row;
    align-items: stretch;
}

.editor-column {
    flex-direction: column;
    min-height: 0;
}

.editor-column--left {
    width: 50%;
    margin-right: 10px;
}

.editor-section {
    margin-bottom: 10px;
    padding-left: 18px;
    padding-right: 18px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 214, 179, 0.12);
    border-bottom-color: rgba(255, 214, 179, 0.12);
    background-color: rgba(45, 19, 21, 0.86);
}

.editor-section--slots {
    flex-grow: 0;
    min-height: 360px;
    margin-bottom: 10px;
}

.editor-section--intel {
    flex-direction: column;
    flex-grow: 1;
    width: 50%;
    min-width: 360px;
    min-height: 0;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    margin-bottom: 0;
}

.editor-section--roster {
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 0;
}

.section-label {
    color: var(--menu-ink);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 10px;
}

.section-copy {
    margin-bottom: 8px;
}

.editor-helper-copy {
    display: none;
}

.team-slot-container {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 0;
}

.team-slot {
    flex-grow: 1;
    min-height: 0;
    margin-right: 8px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 217, 184, 0.10);
    border-bottom-color: rgba(255, 217, 184, 0.10);
    background-color: rgba(255, 214, 168, 0.035);
}

.team-slot--active {
    background-color: rgba(84, 31, 25, 0.80);
    border-top-color: rgba(255, 178, 111, 0.50);
    border-bottom-color: rgba(255, 178, 111, 0.50);
}

.team-slot--drop-target {
    background-color: rgba(143, 61, 36, 0.90);
    border-top-color: rgba(255, 228, 185, 0.94);
    border-bottom-color: rgba(255, 228, 185, 0.94);
    border-left-color: rgba(255, 228, 185, 0.72);
    border-right-color: rgba(255, 228, 185, 0.72);
}

.team-slot-index {
    color: rgba(255, 198, 132, 0.96);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 2px;
}

.team-slot-preview {
    margin-bottom: 4px;
}

.team-slot-name,
.roster-card-name {
    color: var(--menu-ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.team-slot-name {
    font-size: 13px;
    margin-bottom: 2px;
}

.team-slot-meta,
.roster-card-status {
    color: var(--menu-soft-ink);
    font-size: 11px;
    letter-spacing: 1.5px;
}

.team-slot-clear {
    margin-top: 6px;
    height: 28px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 218, 188, 0.14);
    border-bottom-color: rgba(255, 218, 188, 0.14);
    background-color: rgba(55, 20, 20, 0.90);
    color: var(--menu-ink);
    letter-spacing: 2px;
}

.team-slot-clear:hover {
    background-color: rgba(124, 48, 32, 0.98);
}

.roster-scroll-view {
    flex-grow: 1;
}

.character-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding-right: 8px;
}

.roster-card {
    width: 206px;
    min-height: 216px;
    margin-right: 10px;
    margin-bottom: 10px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 217, 184, 0.10);
    border-bottom-color: rgba(255, 217, 184, 0.10);
    background-color: rgba(255, 214, 168, 0.04);
}

.roster-card:hover {
    background-color: rgba(87, 32, 25, 0.84);
    border-top-color: rgba(255, 182, 116, 0.46);
    border-bottom-color: rgba(255, 182, 116, 0.46);
}

.roster-card--assigned {
    background-color: rgba(57, 23, 22, 0.90);
    border-top-color: rgba(255, 182, 116, 0.60);
    border-bottom-color: rgba(255, 182, 116, 0.60);
}

.roster-card-preview {
    margin-bottom: 6px;
}

.roster-card-name {
    font-size: 13px;
    margin-bottom: 4px;
}

.roster-card-status {
    color: rgba(255, 198, 132, 0.96);
}

.roster-card-footer {
    margin-top: auto;
}

.character-detail-subtitle {
    margin-bottom: 6px;
    font-size: 12px;
}

.character-detail-header {
    flex-direction: row;
    margin-bottom: 6px;
}

.character-detail-preview {
    width: 92px;
    height: 104px;
    min-width: 92px;
    min-height: 104px;
    margin-right: 10px;
    background-color: rgba(255, 214, 168, 0.03);
}

.character-detail-heading {
    flex-grow: 1;
    justify-content: center;
}

.character-detail-kicker {
    color: rgba(255, 198, 132, 0.96);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 2px;
}

.character-detail-name {
    color: var(--menu-ink);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 2px;
    white-space: normal;
}

.character-detail-level {
    color: var(--menu-soft-ink);
    font-size: 11px;
    letter-spacing: 1px;
}

.character-detail-summary {
    display: none;
}

.character-detail-summary-line {
    color: var(--menu-soft-ink);
    font-size: 11px;
    letter-spacing: 1.5px;
    margin-bottom: 2px;
}

.character-detail-groups {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
}

.character-detail-group {
    margin-bottom: 6px;
}

.character-detail-group--abilities {
    flex-direction: column;
    flex-grow: 1;
    min-height: 0;
    margin-bottom: 0;
}

.character-detail-group-label {
    color: rgba(255, 198, 132, 0.96);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 4px;
}

.character-stat-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.character-stat-row {
    width: 32.3%;
    min-height: 28px;
    margin-right: 1%;
    margin-bottom: 3px;
    padding-left: 5px;
    padding-right: 5px;
    padding-top: 3px;
    padding-bottom: 3px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 217, 184, 0.08);
    border-bottom-color: rgba(255, 217, 184, 0.08);
    background-color: rgba(255, 214, 168, 0.025);
}

.character-stat-row-label {
    color: var(--menu-soft-ink);
    font-size: 9px;
    letter-spacing: 1px;
    margin-bottom: 0;
}

.character-stat-row-value {
    color: var(--menu-ink);
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.character-detail-abilities-scroll-view {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    height: 180px;
}

.character-detail-abilities {
    flex-direction: column;
    padding-right: 4px;
}

.character-ability-card {
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 6px;
    padding-bottom: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 217, 184, 0.08);
    border-bottom-color: rgba(255, 217, 184, 0.08);
    background-color: rgba(255, 214, 168, 0.025);
}

.character-ability-name {
    color: var(--menu-ink);
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 1px;
}

.character-ability-meta {
    color: rgba(255, 198, 132, 0.96);
    font-size: 9px;
    letter-spacing: 1px;
    margin-bottom: 1px;
}

.character-ability-description {
    color: var(--menu-soft-ink);
    font-size: 10px;
    white-space: normal;
}

.editor-status-label {
    margin-top: 14px;
}

.drag-ghost {
    position: absolute;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(58, 20, 20, 0.96);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 226, 174, 0.90);
    border-bottom-color: rgba(255, 226, 174, 0.90);
    border-left-color: rgba(255, 226, 174, 0.90);
    border-right-color: rgba(255, 226, 174, 0.90);
    color: var(--menu-ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.frame-line {
    position: absolute;
    left: 72px;
    right: 72px;
    height: 1px;
    background-color: rgba(255, 189, 122, 0.50);
}

.frame-line--top {
    top: 40px;
}

.frame-line--bottom {
    bottom: 40px;
}

.host-setup-shell {
    flex-direction: column;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 12px;
    padding-bottom: 12px;
}

.host-setup-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.host-setup-content {
    flex-direction: column;
    padding-right: 8px;
}

.host-setup-scroll-view {
    flex-grow: 1;
    min-height: 0;
    margin-right: -8px;
}

.host-intro-panel {
    margin-bottom: 10px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 186, 118, 0.54);
    border-bottom-color: rgba(255, 186, 118, 0.54);
    border-left-color: rgba(255, 223, 197, 0.12);
    border-right-color: rgba(255, 223, 197, 0.12);
    background-color: rgba(46, 18, 18, 0.92);
}

.host-grid {
    flex-grow: 1;
    flex-wrap: wrap;
    flex-direction: row;
    align-content: flex-start;
    min-height: 0;
}

.host-section {
    min-height: 144px;
}

.host-section--party {
    width: 100%;
    min-height: 0;
    margin-bottom: 10px;
}

.host-section--half {
    width: 49.4%;
    min-width: 360px;
    margin-bottom: 10px;
}

.host-section--left {
    margin-right: 10px;
}

.host-section--enemies {
    width: 100%;
    min-height: 220px;
    margin-right: 0;
}

.host-section-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.host-field-row {
    flex-direction: row;
    justify-content: space-between;
}

.host-field-stack {
    flex-direction: column;
}

.host-number-field {
    flex-grow: 1;
    margin-right: 8px;
    color: var(--menu-ink);
}

.host-number-field--wide {
    margin-right: 0;
    margin-bottom: 10px;
}

.host-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 217, 184, 0.14);
    border-bottom-color: rgba(255, 217, 184, 0.14);
    border-left-color: rgba(255, 217, 184, 0.08);
    border-right-color: rgba(255, 217, 184, 0.08);
    background-color: rgba(255, 214, 168, 0.05);
}

.host-slider-label {
    width: 118px;
    color: var(--menu-soft-ink);
    letter-spacing: 2px;
    font-size: 12px;
}

.host-slider {
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 12px;
}

.host-slider-value {
    width: 24px;
    color: rgba(255, 198, 132, 0.96);
    -unity-font-style: bold;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.host-add-enemy-button {
    min-width: 136px;
}

.host-enemy-scroll-view {
    flex-grow: 1;
    min-height: 132px;
}

.lobby-player-scroll-view {
    flex-grow: 0;
    flex-shrink: 0;
    height: 184px;
    min-height: 184px;
    max-height: 184px;
}

.lobby-player-card-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: flex-start;
    padding-right: 0;
}

.lobby-player-card {
    width: 48.5%;
    min-width: 0;
    min-height: 112px;
    margin-right: 0;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 217, 184, 0.16);
    border-bottom-color: rgba(255, 217, 184, 0.16);
    border-left-color: rgba(255, 217, 184, 0.10);
    border-right-color: rgba(255, 217, 184, 0.10);
    background-color: rgba(64, 24, 24, 0.86);
}

.lobby-player-card--host {
    background-color: rgba(82, 31, 24, 0.90);
    border-top-color: rgba(255, 189, 122, 0.48);
    border-bottom-color: rgba(255, 189, 122, 0.48);
}

.lobby-player-card--local {
    border-left-color: rgba(255, 206, 148, 0.34);
    border-right-color: rgba(255, 206, 148, 0.34);
}

.lobby-player-card-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 6px;
}

.lobby-player-name {
    flex-shrink: 1;
    color: var(--menu-ink);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    white-space: normal;
}

.lobby-player-role {
    color: rgba(255, 198, 132, 0.96);
    font-size: 10px;
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.lobby-player-ready {
    min-width: 88px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    -unity-text-align: middle-center;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
}

.lobby-player-ready--yes {
    color: rgba(255, 244, 224, 1);
    background-color: rgba(120, 53, 34, 0.96);
    border-top-color: rgba(255, 191, 122, 0.58);
    border-bottom-color: rgba(255, 191, 122, 0.58);
    border-left-color: rgba(255, 191, 122, 0.44);
    border-right-color: rgba(255, 191, 122, 0.44);
}

.lobby-player-ready--no {
    color: rgba(243, 205, 176, 0.92);
    background-color: rgba(44, 19, 21, 0.92);
    border-top-color: rgba(255, 217, 184, 0.16);
    border-bottom-color: rgba(255, 217, 184, 0.16);
    border-left-color: rgba(255, 217, 184, 0.12);
    border-right-color: rgba(255, 217, 184, 0.12);
}

.lobby-player-team-list {
    flex-grow: 1;
    min-height: 0;
}

.lobby-player-operative,
.lobby-player-team-empty {
    margin-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 5px;
    padding-bottom: 5px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-color: rgba(255, 217, 184, 0.10);
    border-bottom-color: rgba(255, 217, 184, 0.10);
    background-color: rgba(255, 214, 168, 0.035);
}

.lobby-player-operative {
    color: var(--menu-ink);
    font-size: 11px;
    letter-spacing: 1px;
    white-space: normal;
}

.lobby-player-team-empty {
    color: var(--menu-soft-ink);
    font-size: 10px;
    letter-spacing: 1px;
    white-space: normal;
}

.host-enemy-entry-container {
    flex-direction: column;
    padding-right: 6px;
}

.host-enemy-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 217, 184, 0.14);
    border-bottom-color: rgba(255, 217, 184, 0.14);
    border-left-color: rgba(255, 217, 184, 0.08);
    border-right-color: rgba(255, 217, 184, 0.08);
    background-color: rgba(255, 214, 168, 0.05);
}

.host-enemy-dropdown {
    flex-grow: 1;
    margin-right: 8px;
    color: var(--menu-ink);
}

.host-enemy-count-field {
    width: 142px;
    min-width: 142px;
    margin-right: 8px;
    color: var(--menu-ink);
}

.host-enemy-count-field .unity-base-field__label {
    min-width: 46px;
}

.host-enemy-remove-button {
    height: 36px;
    min-width: 98px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 218, 188, 0.20);
    border-bottom-color: rgba(255, 218, 188, 0.20);
    border-left-color: rgba(255, 218, 188, 0.20);
    border-right-color: rgba(255, 218, 188, 0.20);
    background-color: rgba(55, 20, 20, 0.90);
    color: var(--menu-ink);
    font-size: 12px;
    letter-spacing: 1px;
}

.host-enemy-remove-button:hover {
    background-color: rgba(124, 48, 32, 0.98);
}

.relay-code-header {
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 186, 118, 0.54);
    border-bottom-color: rgba(255, 186, 118, 0.54);
    border-left-color: rgba(255, 223, 197, 0.12);
    border-right-color: rgba(255, 223, 197, 0.12);
    background-color: rgba(46, 18, 18, 0.92);
}

.relay-code-header-caption {
    color: var(--menu-soft-ink);
    font-size: 12px;
    letter-spacing: 3px;
    margin-right: 14px;
}

.relay-code-header-label {
    color: var(--menu-ink);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-right: 12px;
}

.relay-copy-button {
    min-width: 146px;
    margin-bottom: 0;
}

.host-setup-status-label {
    margin-top: 14px;
}
