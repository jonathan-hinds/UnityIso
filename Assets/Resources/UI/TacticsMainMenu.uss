:root {
    --menu-ink: rgba(243, 242, 235, 1);
    --menu-soft-ink: rgba(203, 208, 214, 0.82);
    --menu-gold: rgba(194, 164, 104, 1);
    --menu-gold-soft: rgba(194, 164, 104, 0.22);
    --menu-panel: rgba(10, 16, 28, 0.78);
    --menu-panel-strong: rgba(8, 14, 24, 0.92);
    --menu-panel-soft: rgba(255, 255, 255, 0.04);
    --menu-border: rgba(255, 255, 255, 0.10);
    --menu-border-strong: rgba(216, 192, 140, 0.58);
    --menu-accent: rgba(46, 66, 92, 0.98);
}

.menu-root {
    flex-grow: 1;
}

.menu-backdrop {
    flex-grow: 1;
    align-items: stretch;
    justify-content: center;
    padding-left: 72px;
    padding-right: 72px;
    padding-top: 56px;
    padding-bottom: 56px;
    background-color: rgba(6, 10, 18, 0.96);
}

.ambient-glow {
    position: absolute;
    border-radius: 999px;
    opacity: 0.65;
}

.ambient-glow--top {
    left: -140px;
    top: -90px;
    width: 520px;
    height: 520px;
    background-color: rgba(78, 114, 156, 0.18);
}

.ambient-glow--bottom {
    right: -120px;
    bottom: -160px;
    width: 620px;
    height: 620px;
    background-color: rgba(177, 146, 92, 0.10);
}

.menu-shell {
    flex-grow: 1;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.03);
    border-right-color: rgba(255, 255, 255, 0.03);
    background-color: rgba(8, 14, 24, 0.32);
}

.menu-shell--main {
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
}

.crest-column {
    width: 58%;
    justify-content: center;
    padding-left: 56px;
    padding-right: 56px;
    padding-top: 60px;
    padding-bottom: 60px;
}

.chapter-label {
    color: var(--menu-soft-ink);
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 6px;
    margin-bottom: 20px;
}

.crest-line {
    width: 420px;
    height: 1px;
    background-color: rgba(194, 164, 104, 0.85);
    margin-bottom: 26px;
}

.title-label {
    color: var(--menu-ink);
    font-size: 64px;
    -unity-font-style: bold;
    letter-spacing: 14px;
    margin-bottom: 12px;
}

.subtitle-label {
    color: var(--menu-soft-ink);
    font-size: 18px;
    letter-spacing: 3px;
    width: 560px;
    white-space: normal;
}

.main-stage {
    width: 470px;
    align-self: center;
    margin-right: 36px;
    justify-content: center;
}

.flow-panel {
    align-self: stretch;
}

.command-panel {
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 32px;
    padding-bottom: 28px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    background-color: var(--menu-panel);
}

.panel-topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
}

.panel-kicker {
    color: rgba(194, 164, 104, 0.92);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
}

.command-heading {
    color: var(--menu-ink);
    font-size: 19px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 18px;
}

.command-copy,
.editor-copy,
.section-copy,
.auth-dialog-copy {
    color: var(--menu-soft-ink);
    font-size: 14px;
    white-space: normal;
}

.command-copy,
.auth-dialog-copy {
    margin-bottom: 24px;
}

.team-summary-label {
    color: rgba(194, 164, 104, 0.92);
    font-size: 13px;
    letter-spacing: 2px;
    margin-bottom: 18px;
    white-space: normal;
}

.join-address-field {
    margin-bottom: 14px;
    color: var(--menu-ink);
}

.join-address-field--stacked {
    margin-top: 4px;
}

.join-address-field .unity-base-field__label,
.host-number-field .unity-base-field__label,
.host-enemy-count-field .unity-base-field__label,
.host-enemy-dropdown .unity-base-field__label {
    min-width: 118px;
    color: var(--menu-soft-ink);
    letter-spacing: 1px;
}

.join-address-field .unity-base-text-field__input,
.host-number-field .unity-base-text-field__input,
.host-enemy-count-field .unity-base-text-field__input,
.host-enemy-dropdown .unity-base-popup-field__input {
    height: 40px;
    color: var(--menu-ink);
    background-color: rgba(16, 24, 38, 0.94);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
}

.menu-button {
    height: 56px;
    margin-bottom: 14px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    color: rgb(245, 241, 230);
    font-size: 18px;
    -unity-font-style: bold;
    letter-spacing: 6px;
}

.menu-button--primary {
    border-top-color: var(--menu-border-strong);
    border-bottom-color: var(--menu-border-strong);
    border-left-color: var(--menu-border-strong);
    border-right-color: var(--menu-border-strong);
    background-color: rgba(26, 39, 57, 0.94);
}

.menu-button--secondary {
    border-top-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    background-color: rgba(16, 24, 38, 0.94);
}

.menu-button:hover {
    background-color: var(--menu-accent);
    border-top-color: rgba(243, 224, 178, 0.85);
    border-bottom-color: rgba(243, 224, 178, 0.85);
    border-left-color: rgba(243, 224, 178, 0.85);
    border-right-color: rgba(243, 224, 178, 0.85);
}

.menu-button:disabled {
    opacity: 0.45;
}

.menu-button--compact {
    height: 48px;
    min-width: 168px;
    margin-bottom: 0;
}

.menu-button--chrome {
    min-width: 108px;
}

.status-label,
.editor-status-label,
.account-status-label {
    color: rgba(194, 164, 104, 0.92);
    font-size: 13px;
    letter-spacing: 2px;
}

.status-label {
    margin-top: 14px;
    display: none;
}

.status-label--main {
    min-height: 20px;
}

.auth-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(4, 8, 16, 0.58);
}

.auth-dialog {
    width: 480px;
    padding-left: 34px;
    padding-right: 34px;
    padding-top: 30px;
    padding-bottom: 28px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(216, 192, 140, 0.42);
    border-bottom-color: rgba(216, 192, 140, 0.42);
    border-left-color: rgba(255, 255, 255, 0.10);
    border-right-color: rgba(255, 255, 255, 0.10);
    background-color: var(--menu-panel-strong);
}

.auth-dialog-kicker {
    color: rgba(194, 164, 104, 0.92);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.auth-dialog-title {
    color: var(--menu-ink);
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    margin-bottom: 12px;
}

.auth-field {
    margin-bottom: 12px;
}

.auth-button-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 8px;
    margin-bottom: 12px;
}

.auth-button {
    min-width: 0;
    flex-grow: 1;
    margin-right: 10px;
}

.auth-cancel-button {
    align-self: stretch;
}

.editor-shell {
    flex-direction: column;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.editor-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 10px;
}

.editor-button-row {
    flex-direction: row;
}

.editor-button {
    margin-right: 12px;
}

.editor-button-save {
    margin-right: 0;
}

.editor-content {
    flex-grow: 1;
    flex-direction: column;
}

.editor-section {
    margin-bottom: 12px;
    padding-left: 22px;
    padding-right: 22px;
    padding-top: 14px;
    padding-bottom: 14px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: var(--menu-border);
    border-bottom-color: var(--menu-border);
    border-left-color: rgba(255, 255, 255, 0.06);
    border-right-color: rgba(255, 255, 255, 0.06);
    background-color: var(--menu-panel);
}

.editor-section--slots {
    flex-grow: 0;
    min-height: 0;
}

.editor-section--roster {
    flex-grow: 1;
    min-height: 220px;
    margin-bottom: 0;
}

.section-label {
    color: var(--menu-ink);
    font-size: 16px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    margin-bottom: 12px;
}

.section-copy {
    margin-bottom: 10px;
}

.team-slot-container {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 0;
}

.team-slot {
    flex-grow: 1;
    min-height: 0;
    margin-right: 10px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.03);
}

.team-slot--active {
    background-color: rgba(18, 28, 44, 0.78);
    border-top-color: rgba(194, 164, 104, 0.42);
    border-bottom-color: rgba(194, 164, 104, 0.42);
}

.team-slot--drop-target {
    background-color: rgba(35, 56, 80, 0.88);
    border-top-color: rgba(243, 224, 178, 0.92);
    border-bottom-color: rgba(243, 224, 178, 0.92);
    border-left-color: rgba(243, 224, 178, 0.68);
    border-right-color: rgba(243, 224, 178, 0.68);
}

.team-slot-index {
    color: rgba(194, 164, 104, 0.92);
    font-size: 11px;
    letter-spacing: 4px;
    margin-bottom: 4px;
}

.team-slot-preview {
    margin-bottom: 6px;
}

.team-slot-name,
.roster-card-name {
    color: var(--menu-ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.team-slot-name {
    font-size: 14px;
    margin-bottom: 3px;
}

.team-slot-meta,
.roster-card-status {
    color: var(--menu-soft-ink);
    font-size: 11px;
    letter-spacing: 2px;
}

.team-slot-clear {
    margin-top: 8px;
    height: 30px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(12, 18, 28, 0.88);
    color: var(--menu-ink);
    letter-spacing: 2px;
}

.team-slot-clear:hover {
    background-color: rgba(38, 56, 76, 0.98);
}

.roster-scroll-view {
    flex-grow: 1;
}

.character-grid-container {
    flex-direction: row;
    flex-wrap: wrap;
    padding-right: 12px;
}

.roster-card {
    width: 230px;
    min-height: 246px;
    margin-right: 14px;
    margin-bottom: 14px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 14px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.03);
}

.roster-card:hover {
    background-color: rgba(18, 28, 44, 0.82);
    border-top-color: rgba(194, 164, 104, 0.40);
    border-bottom-color: rgba(194, 164, 104, 0.40);
}

.roster-card--assigned {
    background-color: rgba(16, 24, 38, 0.88);
    border-top-color: rgba(194, 164, 104, 0.58);
    border-bottom-color: rgba(194, 164, 104, 0.58);
}

.roster-card-preview {
    margin-bottom: 10px;
}

.roster-card-name {
    font-size: 14px;
    margin-bottom: 6px;
}

.roster-card-status {
    color: rgba(194, 164, 104, 0.92);
}

.editor-status-label {
    margin-top: 14px;
}

.drag-ghost {
    position: absolute;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(12, 18, 28, 0.94);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(243, 224, 178, 0.85);
    border-bottom-color: rgba(243, 224, 178, 0.85);
    border-left-color: rgba(243, 224, 178, 0.85);
    border-right-color: rgba(243, 224, 178, 0.85);
    color: var(--menu-ink);
    -unity-font-style: bold;
    letter-spacing: 3px;
}

.frame-line {
    position: absolute;
    left: 72px;
    right: 72px;
    height: 1px;
    background-color: rgba(194, 164, 104, 0.38);
}

.frame-line--top {
    top: 40px;
}

.frame-line--bottom {
    bottom: 40px;
}

.host-setup-shell {
    flex-direction: column;
    padding-left: 36px;
    padding-right: 36px;
    padding-top: 18px;
    padding-bottom: 18px;
}

.host-setup-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
}

.host-setup-content {
    flex-grow: 1;
}

.host-intro-panel {
    margin-bottom: 12px;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 18px;
    padding-bottom: 18px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(216, 192, 140, 0.42);
    border-bottom-color: rgba(216, 192, 140, 0.42);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(10, 16, 28, 0.9);
}

.host-grid {
    flex-grow: 1;
    flex-wrap: wrap;
    flex-direction: row;
    align-content: flex-start;
}

.host-section {
    min-height: 168px;
}

.host-section--half {
    width: 49.4%;
    min-width: 360px;
    margin-bottom: 12px;
}

.host-section--left {
    margin-right: 12px;
}

.host-section--enemies {
    width: 100%;
    min-height: 286px;
    margin-right: 0;
}

.host-section-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.host-field-row {
    flex-direction: row;
    justify-content: space-between;
}

.host-field-stack {
    flex-direction: column;
}

.host-number-field {
    flex-grow: 1;
    margin-right: 10px;
    color: var(--menu-ink);
}

.host-number-field--wide {
    margin-right: 0;
    margin-bottom: 12px;
}

.host-slider-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.03);
}

.host-slider-label {
    width: 132px;
    color: var(--menu-soft-ink);
    letter-spacing: 2px;
}

.host-slider {
    flex-grow: 1;
    margin-left: 10px;
    margin-right: 12px;
}

.host-slider-value {
    width: 24px;
    color: rgba(194, 164, 104, 0.92);
    -unity-font-style: bold;
    font-size: 15px;
    -unity-text-align: middle-center;
}

.host-add-enemy-button {
    min-width: 154px;
}

.host-enemy-scroll-view {
    flex-grow: 1;
    min-height: 170px;
}

.host-enemy-entry-container {
    flex-direction: column;
    padding-right: 8px;
}

.host-enemy-row {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: 10px;
    padding-left: 14px;
    padding-right: 14px;
    padding-top: 12px;
    padding-bottom: 12px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
    border-left-color: rgba(255, 255, 255, 0.05);
    border-right-color: rgba(255, 255, 255, 0.05);
    background-color: rgba(255, 255, 255, 0.03);
}

.host-enemy-dropdown {
    flex-grow: 1;
    margin-right: 10px;
    color: var(--menu-ink);
}

.host-enemy-count-field {
    width: 170px;
    margin-right: 10px;
    color: var(--menu-ink);
}

.host-enemy-remove-button {
    height: 40px;
    min-width: 120px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    border-left-color: rgba(255, 255, 255, 0.12);
    border-right-color: rgba(255, 255, 255, 0.12);
    background-color: rgba(12, 18, 28, 0.88);
    color: var(--menu-ink);
    letter-spacing: 2px;
}

.host-enemy-remove-button:hover {
    background-color: rgba(38, 56, 76, 0.98);
}

.relay-code-header {
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-color: rgba(216, 192, 140, 0.42);
    border-bottom-color: rgba(216, 192, 140, 0.42);
    border-left-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    background-color: rgba(10, 16, 28, 0.9);
}

.relay-code-header-caption {
    color: var(--menu-soft-ink);
    font-size: 12px;
    letter-spacing: 3px;
    margin-right: 14px;
}

.relay-code-header-label {
    color: var(--menu-ink);
    font-size: 26px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-right: 12px;
}

.relay-copy-button {
    min-width: 146px;
    margin-bottom: 0;
}

.host-setup-status-label {
    margin-top: 14px;
}
